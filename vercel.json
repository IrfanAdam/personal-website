{
  "cleanUrls": false,
  "redirects": [
    { "source": "/admin", "destination": "/admin/", "permanent": false },
    { "source": "/ds", "destination": "/ds/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/admin/:path*", "destination": "/admin/:path*" },
    { "source": "/ds/:path*", "destination": "/ds/:path*" }
  ],
  "headers": [
    {
      "source": "/(images|mocks|icons)/:path*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, must-revalidate" }]
    }
  ]
}
